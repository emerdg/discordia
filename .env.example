# Copie para .env.local e preencha com os valores do seu projeto Firebase.
# Web app config: Firebase Console > Configurações do projeto > Seus apps.

# URL do repositório (usada pela página inicial)
VITE_GITHUB_URL=https://github.com/emerdg/discordia

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=