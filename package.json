{
  "name": "discordia",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Compartilhamento de tela em grupo, 100% P2P via WebRTC. Firebase usado apenas como hub de sinalização.",
  "scripts": {
    "dev": "vite",
    "dev:teste": "vite --config vite.test.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:teste": "vite build --config vite.test.config.ts",
    "preview": "vite preview",
    "deploy": "npm run build && npm run build:teste && firebase deploy --only hosting,database"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "firebase": "^12.17.1"
  },
  "devDependencies": {
    "firebase-tools": "^15.27.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
